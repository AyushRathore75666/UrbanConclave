# Copy to apps/api/.env on first run (the API does this automatically if the file is missing).
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

PORT=4000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# Embedded Postgres starts automatically when this is true (no Docker required).
USE_EMBEDDED_PG=true
EMBEDDED_PG_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/mpgis

# Required. 64 hex characters (32 bytes). The API generates one on first run.
DATA_ENCRYPTION_KEY=
JWT_SECRET=

# First-run admin password for all four seeded accounts. Change it after login.
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_SAMPLE_DATA=true

# When true, and SMTP/SMS are empty, the one-time code is returned to the browser
# so the form can be tested locally. Set to false in production.
OTP_DEV_ECHO=true

# Investment team inbox for new-interest alerts.
INVESTMENT_TEAM_EMAIL=invest-team@mpconclave.example

# SMTP (leave blank locally; messages are written to apps/api/data/outbox.log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MP Conclave GIS <no-reply@mpconclave.example>"

# Generic SMS gateway. The API POSTs JSON { "to", "message" } with
# Authorization: Bearer $SMS_API_KEY. Leave blank locally.
SMS_API_URL=
SMS_API_KEY=

# Optional Google reCAPTCHA. When both are set, the math question is replaced.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

# Optional ClamAV daemon (clamd). When set, uploads are scanned with INSTREAM.
CLAMAV_HOST=
CLAMAV_PORT=3310

TRUST_PROXY=false
