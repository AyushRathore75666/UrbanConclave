generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  CONTENT_EDITOR
  INVESTMENT_TEAM
  VIEWER
}

enum LeadStatus {
  RECEIVED
  UNDER_REVIEW
  CONTACTED
  MEETING_SCHEDULED
  CLOSED
}

enum OrgType {
  PRIVATE
  PUBLIC
  LLP
  STARTUP
  PSU
  FOREIGN
  OTHER
}

enum AmountUnit {
  INR_CRORE
  USD_MILLION
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  role         Role
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())
  notes        Note[]
  assignments  Submission[] @relation("Assignee")
  auditLogs    AuditLog[]
}

model Submission {
  id                 String     @id @default(cuid())
  referenceNumber    String     @unique
  status             LeadStatus @default(RECEIVED)
  isSample           Boolean    @default(false)
  companyName        String
  orgType            OrgType
  country            String
  address            String
  city               String
  stateRegion        String
  pinCode            String
  website            String?
  registrationNumber String?
  contactName        String
  designation        String
  emailCipher        String
  emailHash          String
  mobileCipher       String
  mobileHash         String
  sectors            String[]
  amountValue        Decimal    @db.Decimal(14, 2)
  amountUnit         AmountUnit
  district           String?
  landAcres          Decimal?   @db.Decimal(12, 2)
  expectedEmployment Int?
  timeline           String
  description        String
  supportNeeded      String[]
  attendingAs        String   @default("")
  sessions           String[] @default([])
  hcmRequested       Boolean  @default(false)
  hcmOrganization    String?
  hcmSector          String?
  hcmAmount          Decimal? @db.Decimal(14, 2)
  hcmLocation        String?
  hcmAgenda          String?
  updatesConsent     Boolean  @default(false)
  documentPath       String?
  documentName       String?
  scanResult         String?
  consentAt          DateTime
  assignedToId       String?
  assignedTo         User?      @relation("Assignee", fields: [assignedToId], references: [id])
  cmVisitFixed       Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  notes              Note[]

  @@index([status, createdAt])
  @@index([emailHash])
  @@index([country])
  @@index([cmVisitFixed])
}

model Note {
  id           String     @id @default(cuid())
  submissionId String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation(fields: [authorId], references: [id])
  body         String
  createdAt    DateTime   @default(now())
}

model OtpCode {
  id         String   @id @default(cuid())
  channel    String
  targetHash String
  codeHash   String
  expiresAt  DateTime
  attempts   Int      @default(0)
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([targetHash, channel])
}

model CaptchaChallenge {
  id         String   @id @default(cuid())
  answerHash String
  expiresAt  DateTime
  used       Boolean  @default(false)
}

model ContentDocument {
  locale    String   @id
  data      Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())
}
